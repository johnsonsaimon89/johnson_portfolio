{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/((?!assets|images|dummy|illustrations|favicon|projects|sitemap.xml|robots.txt|_redirects|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
